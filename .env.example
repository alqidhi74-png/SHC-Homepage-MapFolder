# Server-side only. Never expose this value with a VITE_ prefix.
OPENROUTER_API_KEY=

# Use openrouter/free for free inference, openrouter/auto for automatic model selection,
# or any explicit model slug available in your OpenRouter account.
OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Sultan Haitham City Assistant

# One or more HTTPS pages that contain the approved project knowledge.
SHC_KNOWLEDGE_URLS=https://oman.housing.gov.om/city-details/sultan-haitham-city,https://oman.housing.gov.om/greater-muscat,https://oman.housing.gov.om/onss

# Explicit allowlist for knowledge-source hosts (comma-separated).
SHC_ALLOWED_SOURCE_HOSTS=housing.gov.om,oman.housing.gov.om
